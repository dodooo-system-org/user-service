# Application Environment Configuration
# Environment mode (development, production, test)
NODE_ENV=development

# Service Configuration
# Port number for the user service to listen on
SERVICE_PORT=4000

# Database Configuration
# Type of database (postgres, mysql, etc.)
DATABASE_TYPE=postgres
# Database server hostname or IP address
DATABASE_HOST=localhost
# Database server port number
DATABASE_PORT=4001
# Username for database connection
DATABASE_USERNAME=user_service
# Password for database connection
DATABASE_PASSWORD=securepassword
# Name of the database to connect to
DATABASE_NAME=user_service
# Whether to automatically synchronize database schema (use false in production)
DATABASE_SYNCHRONIZE=true

# JWT (JSON Web Token) Configuration
# Secret key used to sign and verify JWT tokens (use a strong, random secret in production)
JWT_SECRET=your_jwt_secret
# Name of the JWT claim that contains the issuer information
JWT_CLAIM_NAME=dodooo
# Expiration time for access tokens (format: 1h, 30m, 5m, etc.)
JWT_ACCESS_TOKEN_EXPIRES_IN=5m
# Expiration time for refresh tokens (format: 7d, 24h, etc.)
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# RabbitMQ Configuration
# RabbitMQ connection URLs (comma-separated for multiple instances)
RABBITMQ_URLS=amqp://guest:guest@localhost:5672
# Name of the RabbitMQ queue for this service
RABBITMQ_QUEUE_NAME=user_service_queue
# Whether the queue should be durable (survives server restarts)
RABBITMQ_QUEUE_DURABLE=true

# Redis Configuration
# Redis server hostname or IP address
REDIS_HOST=localhost
# Redis server port number
REDIS_PORT=6379
# Redis password for authentication
REDIS_PASSWORD=mysecretpassword
# Default time-to-live for cached items in seconds (3600 = 1 hour)
# REDIS_TTL=60

# Mailer Configuration
# Email address used for sending emails (sender email)
MAILER_USER=your-email@example.com
# App password for email authentication
MAILER_PASSWORD=your-app-password
# SMTP server hostname
MAILER_HOST=smtp.gmail.com
# SMTP server port number
MAILER_PORT=587
# Whether to use secure connection (true for SSL, false for TLS)
MAILER_SECURE=false

# Secret key configuration
# Secret key for email verification tokens
EMAIL_VERIFICATION_SECRET=your-email-verification-secret
# Secret key for password reset tokens
PASSWORD_RESET_SECRET=your-password-reset-secret

# Application Configuration
# Description of the application
APP_DESCRIPTION=Education Platform
# Name of the application
APP_NAME=Dodooo
# Version number of the application
APP_VERSION=1
# Client application URL (frontend URL)
APP_CLIENT_URL=http://localhost:3000